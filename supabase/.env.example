# Copy to supabase/.env.local for local serve; use Supabase function secrets remotely.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase, not Vite.
# New Supabase secret key: set this optional override (never prefix custom secrets SUPABASE_).
SB_SECRET_KEY=
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4173
# Independent random values of at least 32 characters. Rotate with an access recovery plan.
ACCESS_TOKEN_SECRET=
RATE_LIMIT_SALT=
SCHEDULER_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend adapter
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
SUPPORT_EMAIL=
BUSINESS_POSTAL_ADDRESS=
# Private bucket object paths. Supply real licensed files; do not use public preview art.
PRIVATE_FILE_PATHS={"lead-magnet":"rewards/accion-wallpaper.jpg","accion-wallpaper":"paid/accion-wallpaper-pack.zip"}
# Optional Meta integration; select a supported Graph version in your Meta app.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=
META_TEST_EVENT_CODE=
