{
  "name": "jona-direct-to-fan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:payments": "node scripts/dev-payments.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:payments": "playwright test --config playwright.payment.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "node supabase/tests/database.mjs",
    "test:edge": "deno task --config supabase/deno.json check && deno task --config supabase/deno.json test",
    "qa:visual": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "latest",
    "@fontsource/geist-mono": "latest",
    "@fontsource/instrument-serif": "latest",
    "@fontsource/sofia-sans-extra-condensed": "latest",
    "@gsap/react": "latest",
    "@tailwindcss/vite": "latest",
    "gsap": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
