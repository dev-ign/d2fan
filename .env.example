# Browser-visible only. Never put privileged keys in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_META_PIXEL_ID=
# Stage A keeps public payment entry points disabled. Stage B requires approval.
VITE_COMMERCE_ENABLED=false
VITE_SUPPORT_ENABLED=false
# The SPA uses its current origin. Provider redirects use server PUBLIC_SITE_URL.
